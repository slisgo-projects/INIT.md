# Ignore everything, then allow only markdown files
*
!*.md
!/.gitignore
!/LICENSE

# Allow the ancillary/ directory and its markdown files
!ancillary/
!ancillary/*.md

# Allow the reports/ directory and its markdown files
!reports/
!reports/*.md

# Allow project skills; other .claude/ local config stays ignored
!.claude/
!.claude/skills/
!.claude/skills/*/
!.claude/skills/*/SKILL.md

# Allow scripts and the redundancy study; raw transcripts stay local
!scripts/
!scripts/*.py
!study/
!study/**
study/raw/
__pycache__/
